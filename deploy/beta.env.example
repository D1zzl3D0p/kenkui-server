# Copy to an untracked private file or the deployment secret manager.
DATABASE_URL=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_SALT=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=https://api.kenkui.fm/v1/auth/callback
KENKUI_WEB_ORIGIN=https://app.kenkui.fm
KENKUI_SESSION_SECRET=
KENKUI_INVITED_EMAILS=
KENKUI_VOICE_SET=vctk
KENKUI_BETA_CREDITS=1000
KENKUI_MAX_JOBS=2
KENKUI_DEPLOYMENT=production
KENKUI_MODAL_APP=kenkui-production
MODAL_ENVIRONMENT=production
# Deployment-machine setting: pre-created Modal outbound proxy name.
KENKUI_MODAL_PROXY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Character attribution models. The hosted default is used when this is empty.
KENKUI_MODEL_ALLOWLIST=openrouter/deepseek/deepseek-v4-flash

# Flat price: 1000 credits per conversion; independent long-book size cap.
KENKUI_MAX_SPEECH_CHARACTERS=10000000
