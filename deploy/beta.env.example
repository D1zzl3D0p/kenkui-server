# Copy to an untracked private file or the deployment secret manager.
DATABASE_URL=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_SALT=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=https://api.kenkui.fm/v1/auth/callback
# Enable desktop PKCE only after registering this additional WorkOS redirect:
# KENKUI_NATIVE_REDIRECT_URI=http://127.0.0.1:43827/callback
KENKUI_WEB_ORIGIN=https://app.kenkui.fm
KENKUI_API_ORIGIN=https://api.kenkui.fm
KENKUI_SESSION_SECRET=
KENKUI_INVITED_EMAILS=
KENKUI_VOICE_SET=vctk
KENKUI_BETA_CREDITS=1000
KENKUI_MAX_JOBS=2
KENKUI_DEPLOYMENT=production
KENKUI_MODAL_APP=kenkui-production
MODAL_ENVIRONMENT=production
# Deployment-machine setting: pre-created Modal outbound proxy name.
KENKUI_MODAL_PROXY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Character attribution models. The hosted default is used when this is empty.
KENKUI_MODEL_ALLOWLIST=openrouter/deepseek/deepseek-v4-flash

# Independent long-book size cap.
KENKUI_MAX_SPEECH_CHARACTERS=10000000

# Paid checkout: use test credentials in staging, live credentials in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Estimated compute cents per million speech characters (before markup).
KENKUI_ESTIMATED_COST_CENTS_PER_MILLION=126

# Managed Payments tax category: cloud-based AI service for personal use.
KENKUI_STRIPE_TAX_CODE=txcd_10105001

# Completion email. Leave KENKUI_SMTP_PASSWORD empty to run without notifications;
# the server then advertises no email capability and offers nobody the switch.
# iCloud+ custom domains authenticate as the Apple ID and send as the alias, so
# the app-specific password belongs to KENKUI_SMTP_USERNAME, not to the sender.
KENKUI_SMTP_HOST=smtp.mail.me.com
KENKUI_SMTP_PORT=587
KENKUI_SMTP_USERNAME=
KENKUI_SMTP_PASSWORD=
KENKUI_SMTP_SENDER=team@kenkui.fm
KENKUI_SMTP_SENDER_NAME=Kenkui
# Signs unsubscribe links. Shared with the workers, unlike the session secret.
KENKUI_UNSUBSCRIBE_SECRET=
