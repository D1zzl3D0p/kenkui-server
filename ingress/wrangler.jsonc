{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kenkui-api-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1},
    "traces": {"enabled": true, "head_sampling_rate": 0.01}
  },
  // Explicit release config supplies reviewed ORIGIN_URL and routes. Empty origin fails closed.
  // Namespace IDs are reserved here; verify no account collision before Task 13 deployment.
  "env": {
    "staging": {
      "name": "kenkui-api-staging",
      "vars": {"ORIGIN_URL": "", "ALLOWED_ORIGINS": "https://app.staging.kenkui.fm"},
      "secrets": {"required": ["KENKUI_ORIGIN_SECRET"]},
      "ratelimits": [
        {"name": "PUBLIC_LIMIT", "namespace_id": "12001", "simple": {"limit": 240, "period": 60}},
        {"name": "LOGIN_LIMIT", "namespace_id": "12002", "simple": {"limit": 30, "period": 60}},
        {"name": "COSTLY_LIMIT", "namespace_id": "12003", "simple": {"limit": 30, "period": 60}}
      ]
    },
    "production": {
      "name": "kenkui-api-production",
      "vars": {"ORIGIN_URL": "", "ALLOWED_ORIGINS": "https://app.kenkui.fm"},
      "secrets": {"required": ["KENKUI_ORIGIN_SECRET"]},
      "ratelimits": [
        {"name": "PUBLIC_LIMIT", "namespace_id": "12011", "simple": {"limit": 240, "period": 60}},
        {"name": "LOGIN_LIMIT", "namespace_id": "12012", "simple": {"limit": 30, "period": 60}},
        {"name": "COSTLY_LIMIT", "namespace_id": "12013", "simple": {"limit": 30, "period": 60}}
      ]
    }
  }
}
