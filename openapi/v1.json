            "type": "array"
          },
          "sourceId": {
            "title": "Sourceid",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "title",
          "author",
          "chapters"
        ],
        "title": "BookResponse",
        "type": "object"
      },
      "Capabilities": {
