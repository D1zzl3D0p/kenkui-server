          }
        },
        "required": [
          "voiceId"
        ],
        "title": "CastingRequest",
        "type": "object"
      },
      "ChapterResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "speechCharacters": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
