            "default": {
              "mode": "unmetered"
            }
          },
          "casting": {
            "$ref": "#/components/schemas/CastingCapabilities",
            "default": {
              "mode": "single"
            }
          },
          "outputFormats": {
            "items": {
              "const": "m4b",
              "type": "string"
            },
            "title": "Outputformats",
            "type": "array"
          },
          "sourceFormats": {
            "items": {
              "const": "epub",
              "type": "string"
            },
            "title": "Sourceformats",
            "type": "array"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "CastingCapabilities": {
        "description": "Casting modes supported by this server.",
        "properties": {
          "mode": {
            "const": "single",
            "default": "single",
            "title": "Mode",
            "type": "string"
          }
        },
