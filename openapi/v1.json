            "type": "array"
          },
          "output": {
            "$ref": "#/components/schemas/OutputRequest",
            "default": {
              "format": "m4b"
            }
          },
          "sourceId": {
            "title": "Sourceid",
            "type": "string"
          },
          "tts": {
            "$ref": "#/components/schemas/TtsRequest",
            "default": {
              "normalizeText": true
            }
          }
        },
        "required": [
