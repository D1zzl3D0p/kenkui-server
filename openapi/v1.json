{
  "openapi": "3.1.0",
  "info": {
    "title": "Kenkui Server API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/assets": {
      "post": {
        "tags": [
          "assets"
        ],
        "summary": "Upload Asset",
        "description": "Accept one EPUB body and retain it behind a server-assigned private path.",
        "operationId": "upload_asset_v1_assets_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/{asset_id}/book": {
      "get": {
        "tags": [
          "assets"
        ],
        "summary": "Inspect Book",
        "description": "Inspect an owned local EPUB through Kenkui's public Pipeline API.",
        "operationId": "inspect_book_v1_assets__asset_id__book_get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/{asset_id}/cover": {
      "get": {
        "tags": [
          "assets"
        ],
        "summary": "Get Cover",
        "operationId": "get_cover_v1_assets__asset_id__cover_get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "assets"
        ],
        "summary": "Upload Cover",
        "description": "Create a new owned EPUB; never mutate a source used by another draft/job.",
        "operationId": "upload_cover_v1_assets__asset_id__cover_post",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voices": {
      "get": {
        "tags": [
          "voices"
        ],
        "summary": "List Voices",
        "description": "Return only enabled entries in the server's explicit local registry.",
        "operationId": "list_voices_v1_voices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/history": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "Credit History",
        "operationId": "credit_history_v1_billing_history_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditHistoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing": {
      "get": {
        "tags": [
          "billing"
        ],
        "summary": "Billing",
        "description": "Local execution has no credits, provider, or reservation workflow.",
        "operationId": "billing_v1_billing_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/checkout": {
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Checkout",
        "operationId": "checkout_v1_billing_checkout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Checkout V1 Billing Checkout Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/preflight": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Preflight",
        "description": "Validate executable local intent without creating a Job or reservation.",
        "operationId": "preflight_v1_jobs_preflight_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreflightResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "description": "Admit local work or hosted credit-backed work before starting its runner.",
        "operationId": "create_job_v1_jobs_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "description": "Return local jobs, or only the caller's owned jobs in hosted mode.",
        "operationId": "list_jobs_v1_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "description": "Return the authoritative durable snapshot used for SSE reconnect recovery.",
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel Job",
        "description": "Durably request cancellation once; repeated calls return the same snapshot.",
        "operationId": "cancel_job_v1_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Stream Events",
        "description": "Stream append-only events; callers re-fetch the snapshot after reconnecting.",
        "operationId": "stream_events_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/artifact": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Artifact",
        "description": "Authorize artifact retrieval from an owned completed local job only.",
        "operationId": "get_artifact_v1_jobs__job_id__artifact_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health V1 Health Get"
                }
              }
            }
          },
          "500": {
            "description": "Normalized internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "500": {
            "description": "Normalized internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "format": {
            "type": "string",
            "title": "Format"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "id",
          "format",
          "sha256"
        ],
        "title": "AssetResponse"
      },
      "AuthCapabilities": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "session",
              "bearer"
            ],
            "title": "Mode",
            "default": "none"
          }
        },
        "type": "object",
        "title": "AuthCapabilities",
        "description": "Authentication modes supported by this server."
      },
      "BillingCapabilities": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "unmetered",
              "credits"
            ],
            "title": "Mode",
            "default": "unmetered"
          }
        },
        "type": "object",
        "title": "BillingCapabilities",
        "description": "Billing modes supported by this server."
      },
      "BillingResponse": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "availableCredits": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Availablecredits"
          },
          "checkoutEnabled": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkoutenabled"
          },
          "packs": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CreditPackResponse"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Packs"
          },
          "creditHistoryAvailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credithistoryavailable"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "BillingResponse"
      },
      "BookResponse": {
        "properties": {
          "sourceId": {
            "type": "string",
            "title": "Sourceid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/ChapterResponse"
            },
            "type": "array",
            "title": "Chapters"
          }
        },
        "type": "object",
        "required": [
          "sourceId",
          "title",
          "author",
          "chapters"
        ],
        "title": "BookResponse"
      },
      "Capabilities": {
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "1",
            "title": "Apiversion",
            "default": "1"
          },
          "auth": {
            "$ref": "#/components/schemas/AuthCapabilities",
            "default": {
              "mode": "none"
            }
          },
          "billing": {
            "$ref": "#/components/schemas/BillingCapabilities",
            "default": {
              "mode": "unmetered"
            }
          },
          "sourceFormats": {
            "items": {
              "type": "string",
              "const": "epub"
            },
            "type": "array",
            "title": "Sourceformats",
            "default": [
              "epub"
            ]
          },
          "outputFormats": {
            "items": {
              "type": "string",
              "const": "m4b"
            },
            "type": "array",
            "title": "Outputformats",
            "default": [
              "m4b"
            ]
          },
          "casting": {
            "$ref": "#/components/schemas/CastingCapabilities",
            "default": {
              "modes": [
                "single"
              ],
              "models": []
            }
          },
          "covers": {
            "$ref": "#/components/schemas/CoverCapabilities",
            "default": {
              "read": true,
              "upload": true,
              "maxUploadBytes": 8388608
            }
          },
          "maxUploadBytes": {
            "type": "integer",
            "title": "Maxuploadbytes",
            "default": 52428800
          }
        },
        "type": "object",
        "title": "Capabilities",
        "description": "Public, versioned declaration of local server features."
      },
      "CastingCapabilities": {
        "properties": {
          "modes": {
            "items": {
              "type": "string",
              "enum": [
                "single",
                "characters"
              ]
            },
            "type": "array",
            "title": "Modes",
            "default": [
              "single"
            ]
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "title": "CastingCapabilities",
        "description": "Casting modes supported by this server.\n\nA list rather than one value: character casting is advertised only where a\ndeployment has configured an LLM allowlist, so a browser can tell the two\napart without trying and failing."
      },
      "CastingRequest": {
        "properties": {
          "voiceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voiceid"
          },
          "narratorVoiceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Narratorvoiceid"
          },
          "unknownVoiceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unknownvoiceid"
          },
          "cast": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Cast"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "gendered"
          },
          "modelId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modelid"
          }
        },
        "type": "object",
        "title": "CastingRequest",
        "description": "Either a single narrator, or a character cast.\n\nvoiceId alone means single casting. Naming a model means character\ncasting, since attribution cannot run without one."
      },
      "ChapterResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "speechCharacters": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speechcharacters"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "ChapterResponse"
      },
      "CheckoutRequest": {
        "properties": {
          "credits": {
            "type": "integer",
            "title": "Credits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "credits"
        ],
        "title": "CheckoutRequest",
        "description": "Only a pack size comes from the browser; account and price are server-owned."
      },
      "CoverCapabilities": {
        "properties": {
          "read": {
            "type": "boolean",
            "title": "Read",
            "default": true
          },
          "upload": {
            "type": "boolean",
            "title": "Upload",
            "default": true
          },
          "maxUploadBytes": {
            "type": "integer",
            "title": "Maxuploadbytes",
            "default": 8388608
          }
        },
        "type": "object",
        "title": "CoverCapabilities"
      },
      "CreditHistoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CreditLotResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CreditHistoryResponse"
      },
      "CreditLotResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "purchase",
              "grant",
              "legacy"
            ],
            "title": "Source"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "credited": {
            "type": "integer",
            "title": "Credited"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "reserved": {
            "type": "integer",
            "title": "Reserved"
          },
          "consumed": {
            "type": "integer",
            "title": "Consumed"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Recordedat"
          },
          "usageStatus": {
            "type": "string",
            "enum": [
              "unused",
              "reserved",
