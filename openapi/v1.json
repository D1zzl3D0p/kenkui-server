          "chapters",
          "casting"
        ],
        "title": "JobRequest",
        "type": "object"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/ProgressResponse"
          },
