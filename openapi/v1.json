          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "stage",
          "completed",
          "total"
        ],
        "title": "ProgressResponse",
        "type": "object"
      },
      "TtsRequest": {
        "properties": {
          "normalizeText": {
            "default": true,
            "title": "Normalizetext",
            "type": "boolean"
          }
        },
        "title": "TtsRequest",
        "type": "object"
      },
      "ValidationError": {
